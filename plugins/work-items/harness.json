{
  "schema_version": 1,
  "plugin": "tj-agents/work-items",
  "source_roots": [
    ".agents/work-items"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/work-items",
      "tj-agents/base"
    ],
    "hooks": [],
    "permissions": {
      "claude_allow": [
        "Bash(tj item:*)",
        "Bash(tj-item:*)",
        "PowerShell(tj item:*)",
        "PowerShell(tj-item:*)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            "tj",
            "item"
          ],
          "justification": "Read and update work items in the repository's selected tracker.",
          "match": [
            [
              "tj",
              "item",
              "resolve",
              "461"
            ]
          ],
          "not_match": [
            [
              "tj",
              "run"
            ]
          ]
        }
      ]
    }
  }
}
